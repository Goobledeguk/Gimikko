# ---------------------------------------------------------------------
# Supabase connection settings for Gimikko.
#
# Expo only exposes variables that start with EXPO_PUBLIC_ to your app
# code, and it bakes their values into the bundle at build time — so:
#   * after editing this file, restart with:  npx expo start -c
#   * NEVER put a secret key (sb_secret_... / service_role) in here.
#     Anything in this file ships inside the app and can be read by users.
#     The publishable key below is designed to be public; Row Level
#     Security (see supabase/schema.sql) is what actually protects data.
# ---------------------------------------------------------------------

# Dashboard -> Project Settings -> Data API  (e.g. https://abcdxyz.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://zkhznzoliwrgylykqxtf.supabase.co

# Dashboard -> Project Settings -> API Keys -> "Publishable key" (sb_publishable_...)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE
